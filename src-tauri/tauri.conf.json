{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jot",
  "version": "0.1.18",
  "identifier": "cc.apidata.jot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "即记 (Jot)",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": true,
        "decorations": false,
        "visible": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/.assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/*"],
    "linux": {
      "deb": {
        "desktopTemplate": "deb.desktop.hbs"
      }
    },
    "externalBin": ["binaries/jot-mcp"],
    "fileAssociations": [
      {
        "name": "Markdown",
        "description": "Markdown 文件",
        "ext": ["md", "markdown", "mdown", "mdwn"],
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
